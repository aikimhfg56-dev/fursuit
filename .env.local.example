# Copy this file to .env.local and fill in values as each external account
# is created. Every integration in the codebase checks for these at runtime
# (see src/lib/env.ts) and degrades to a "not configured yet" state when a
# section below is left blank, so the site keeps working while you fill
# these in gradually.

# --- Sanity (CMS: products, categories, commission page copy, promo codes) ---
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=

# --- Stripe (card, Alipay, Revolut Pay via Stripe Checkout) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- PayPal (Orders v2 REST API) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# "sandbox" while testing, "live" once ready to accept real payments
PAYPAL_ENV=sandbox

# --- Wise (manual bank transfer instructions, not an automated API) ---
WISE_ACCOUNT_HOLDER=
WISE_IBAN=
WISE_BIC=
WISE_ACCOUNT_NUMBER=
WISE_SORT_CODE=
WISE_BANK_COUNTRY=

# --- Resend (quote/contact form email delivery) ---
RESEND_API_KEY=
CONTACT_NOTIFICATION_EMAIL=

# --- Currency conversion ---
EXCHANGE_RATE_API_KEY=

# --- Clerk (customer accounts: sign-up/sign-in, sessions, optional MFA) ---
# In the Clerk Dashboard, enable "Name" under User & Authentication ->
# Personal Information so sign-up collects first/last name.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
